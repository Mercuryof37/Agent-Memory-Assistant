{
  "name": "@agent_memory/dsh",
  "version": "0.5.0",
  "private": false,
  "license": "MIT",
  "description": "Agent Memory plugin for DeepSeek Harness: local, file-per-memory long-term memory with human approval.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mercuryof37/Agent-Memory-Assistant.git",
    "directory": "packages/dsh"
  },
  "homepage": "https://github.com/Mercuryof37/Agent-Memory-Assistant#readme",
  "bugs": {
    "url": "https://github.com/Mercuryof37/Agent-Memory-Assistant/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/plugin.mjs",
  "exports": {
    ".": "./dist/plugin.mjs",
    "./settings": "./src/settings.ts",
    "./client": "./client/client.js"
  },
  "files": [
    "dist",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  }
}
